diff --git a/excalidraw-app/localidraw.ts b/excalidraw-app/localidraw.ts
new file mode 100644
index 0000000..c109d92
--- /dev/null
+++ b/excalidraw-app/localidraw.ts
@@ -0,0 +1,326 @@
+import {
+  CaptureUpdateAction,
+  convertToExcalidrawElements,
+  exportToBlob,
+  exportToSvg,
+  getSceneVersion,
+  restoreElements,
+} from "@excalidraw/excalidraw";
+import { serializeAsJSON } from "@excalidraw/excalidraw/data/json";
+import {
+  DEFAULT_ELEMENT_PROPS,
+  DEFAULT_FONT_SIZE,
+  MIME_TYPES,
+  debounce,
+  randomId,
+} from "@excalidraw/common";
+import { getNonDeletedElements } from "@excalidraw/element";
+
+import type { ExcalidrawImperativeAPI } from "@excalidraw/excalidraw/types";
+
+import { STORAGE_KEYS } from "./app_constants";
+
+// The localidraw server owns the drawing shown on this port: load it on start,
+// mirror every change back, and pick up edits made elsewhere (e.g. by the CLI).
+
+// This port may have shown a different drawing before, so never restore the
+// scene the browser cached for it; the server's copy is loaded instead.
+localStorage.removeItem(STORAGE_KEYS.LOCAL_STORAGE_ELEMENTS);
+
+// Likewise, the font and sloppiness last picked on this port must not replace
+// the defaults for the drawing it shows now.
+const savedState = JSON.parse(
+  localStorage.getItem(STORAGE_KEYS.LOCAL_STORAGE_APP_STATE) ?? "{}",
+);
+delete savedState.currentItemFontFamily;
+delete savedState.currentItemRoughness;
+localStorage.setItem(
+  STORAGE_KEYS.LOCAL_STORAGE_APP_STATE,
+  JSON.stringify(savedState),
+);
+
+// set so App.tsx skips Excalidraw's cross-tab sync from browser storage
+export const isLocalidraw = true;
+
+// served by the localidraw server on its main port
+export const GALLERY_URL = "/localidraw/gallery";
+
+let rev: string | null = null;
+let exists = false;
+let lastSavedVersion = -1;
+let isSaving = false;
+let saving: Promise<void> = Promise.resolve();
+let api: ExcalidrawImperativeAPI | null = null;
+
+const exporters: Partial<
+  Record<
+    string,
+    (opts: Parameters<typeof exportToSvg>[0]) => Promise<string | Blob>
+  >
+> = {
+  svg: async (opts) => (await exportToSvg(opts)).outerHTML,
+  png: (opts) =>
+    exportToBlob({
+      ...opts,
+      mimeType: "image/png",
+      // exportScale is only read together with maxWidthOrHeight
+      getDimensions: (width, height) => ({
+        width: width * 2,
+        height: height * 2,
+        scale: 2,
+      }),
+    }),
+};
+const exportParams = new URLSearchParams(location.search);
+const exporter = exporters[exportParams.get("export") ?? ""];
+
+const save = async () => {
+  // an export must not change the drawing or mark it for sync
+  if (!api || exporter) {
+    return;
+  }
+  const elements = api.getSceneElementsIncludingDeleted();
+  const appState = api.getAppState();
+  const files = api.getFiles();
+  const version = getSceneVersion(elements);
+  const visibleElements = getNonDeletedElements(elements);
+  // skip untouched blank canvases so they don't clutter the gallery
+  if (
+    rev === null ||
+    version === lastSavedVersion ||
+    (!visibleElements.length && !exists)
+  ) {
+    return;
+  }
+  isSaving = true;
+  try {
+    const svg = await exportToSvg({
+      elements: visibleElements,
+      appState: { ...appState, exportBackground: true },
+      files,
+      skipInliningFonts: true,
+    });
+    const response = await fetch("/localidraw/save", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        rev,
+        scene: serializeAsJSON(elements, appState, files, "local"),
+        // the export format drops the name; keep it for the gallery
+        name: appState.name,
+        svg: svg.outerHTML,
+      }),
+    });
+    if (response.ok) {
+      ({ rev } = await response.json());
+      exists = true;
+      lastSavedVersion = version;
+    } else if (response.status === 409) {
+      // someone else changed the drawing since we loaded it: reload theirs
+      window.location.reload();
+    }
+  } finally {
+    isSaving = false;
+  }
+};
+
+export const saveToLocalidraw = debounce(() => {
+  saving = save();
+}, 1000);
+
+const renderLatex = async (elements: any[]) => {
+  const equations = elements.filter(
+    (element) => element.type === "image" && element.latex,
+  );
+  if (!equations.length) {
+    return [];
+  }
+  const [
+    { mathjax },
+    { TeX },
+    { SVG },
+    { liteAdaptor },
+    { RegisterHTMLHandler },
+    { AllPackages },
+  ] = await Promise.all([
+    import("mathjax-full/js/mathjax.js"),
+    import("mathjax-full/js/input/tex.js"),
+    import("mathjax-full/js/output/svg.js"),
+    import("mathjax-full/js/adaptors/liteAdaptor.js"),
+    import("mathjax-full/js/handlers/html.js"),
+    import("mathjax-full/js/input/tex/AllPackages.js"),
+  ]);
+  const adaptor = liteAdaptor();
+  RegisterHTMLHandler(adaptor);
+  const doc = mathjax.document("", {
+    InputJax: new TeX({ packages: AllPackages }),
+    OutputJax: new SVG({ fontCache: "none" }),
+  });
+  return equations.flatMap((element) => {
+    const svg: string = adaptor.innerHTML(
+      doc.convert(element.latex, { display: true }),
+    );
+    const error = svg.match(/data-mjx-error="([^"]*)"/);
+    if (error) {
+      Object.assign(element, {
+        type: "text",
+        text: `LaTeX error: ${error[1]}\n${element.latex}`,
+        strokeColor: "#e03131",
+      });
+      return [];
+    }
+    // the viewBox is in thousandths of an em
+    const [, , width, height] = svg
+      .match(/viewBox="([^"]+)"/)![1]
+      .split(" ")
+      .map(
+        (value) =>
+          (Number(value) * (element.fontSize ?? DEFAULT_FONT_SIZE)) / 1000,
+      );
+    const sized = svg
+      .replace(
+        /width="[^"]+" height="[^"]+"/,
+        `width="${width}" height="${height}"`,
+      )
+      .replaceAll(
+        "currentColor",
+        element.strokeColor ?? DEFAULT_ELEMENT_PROPS.strokeColor,
+      );
+    Object.assign(element, {
+      fileId: randomId(),
+      status: "saved",
+      width,
+      height,
+    });
+    return [
+      {
+        id: element.fileId,
+        mimeType: MIME_TYPES.svg,
+        dataURL: `data:${MIME_TYPES.svg},${encodeURIComponent(sized)}`,
+        created: Date.now(),
+      },
+    ];
+  });
+};
+
+const hasUnsavedChanges = (api: ExcalidrawImperativeAPI) =>
+  getSceneVersion(api.getSceneElementsIncludingDeleted()) !== lastSavedVersion;
+
+const loadScene = async (
+  api: ExcalidrawImperativeAPI,
+  isInitialLoad: boolean,
+) => {
+  const response = await fetch(
+    isInitialLoad ? "/localidraw/scene" : `/localidraw/scene?rev=${rev}`,
+  );
+  if (response.status !== 200) {
+    return;
+  }
+  const data = await response.json();
+  const scene = data.scene ?? {};
+  // a skeleton without an id gets one, so its expansion replaces it below
+  const rawElements: any[] = (scene.elements ?? []).map((element: any) => ({
+    id: randomId(),
+    ...element,
+  }));
+  const equations = await renderLatex(rawElements);
+  // the user started editing while we were fetching: keep their changes
+  if (!isInitialLoad && (isSaving || hasUnsavedChanges(api))) {
+    return;
+  }
+  // the CLI may write simplified element skeletons; expand them here
+  // (converted together so arrows can bind to shapes by id, then put back in
+  // their original order, which is also the drawing order)
+  const converted = new Map(
+    convertToExcalidrawElements(
+      rawElements.filter((element) => element.version === undefined),
+      { regenerateIds: false },
+    ).map((element) => [element.id, element]),
+  );
+  const elements = restoreElements(
+    [
+      ...rawElements.map((element) => converted.get(element.id) ?? element),
+      // skeleton labels and bound text have no entry of their own in rawElements
+      ...[...converted.values()].filter(
+        (element) => !rawElements.some((raw) => raw.id === element.id),
+      ),
+    ],
+    null,
+    { repairBindings: true },
+  );
+  api.updateScene({
+    elements,
+    appState: {
+      name: scene.appState?.name ?? null,
+      viewBackgroundColor: scene.appState?.viewBackgroundColor ?? "#ffffff",
+    },
+    captureUpdate: CaptureUpdateAction.NEVER,
+  });
+  api.addFiles([...Object.values<any>(scene.files ?? {}), ...equations]);
+  rev = data.rev;
+  exists = !!data.scene;
+  lastSavedVersion = getSceneVersion(api.getSceneElementsIncludingDeleted());
+  if (isInitialLoad && elements.length) {
+    api.setViewport({ target: elements, fit: "scale-down" });
+  }
+  // drawings written by the CLI have no thumbnail yet: save once to render it
+  if (exists && !data.hasThumb) {
+    lastSavedVersion = -1;
+    saveToLocalidraw();
+  }
+};
+
+export const startLocalidraw = (excalidrawAPI: ExcalidrawImperativeAPI) => {
+  if (api) {
+    return;
+  }
+  api = excalidrawAPI;
+  if (exporter) {
+    (async () => {
+      await loadScene(excalidrawAPI, true);
+      const body = await exporter({
+        elements: getNonDeletedElements(
+          excalidrawAPI.getSceneElementsIncludingDeleted(),
+        ),
+        appState: { ...excalidrawAPI.getAppState(), exportBackground: true },
+        files: excalidrawAPI.getFiles(),
+      });
+      fetch(`/localidraw/export/${exportParams.get("token")}`, {
+        method: "POST",
+        body,
+      });
+    })();
+    return;
+  }
+  loadScene(excalidrawAPI, true);
+  window.setInterval(() => {
+    if (rev !== null && !isSaving && !hasUnsavedChanges(excalidrawAPI)) {
+      loadScene(excalidrawAPI, false);
+    }
+  }, 2000);
+  window.addEventListener(
+    "keydown",
+    async (event) => {
+      if (
+        !(event.ctrlKey || event.metaKey) ||
+        event.shiftKey ||
+        event.key.toLowerCase() !== "s"
+      ) {
+        return;
+      }
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      saveToLocalidraw.flush();
+      await saving;
+      const response = await fetch("/localidraw/sync", { method: "POST" });
+      const { synced } = await response.json();
+      excalidrawAPI.setToast({
+        message: synced
+          ? "Synced to Hugging Face"
+          : "Saved locally, will sync when online",
+        duration: 3000,
+      });
+    },
+    { capture: true },
+  );
+};
