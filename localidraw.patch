diff --git a/excalidraw-app/localidraw.ts b/excalidraw-app/localidraw.ts
new file mode 100644
index 00000000..4790a31f
--- /dev/null
+++ b/excalidraw-app/localidraw.ts
@@ -0,0 +1,189 @@
+import {
+  CaptureUpdateAction,
+  convertToExcalidrawElements,
+  exportToSvg,
+  getSceneVersion,
+  restoreElements,
+} from "@excalidraw/excalidraw";
+import { serializeAsJSON } from "@excalidraw/excalidraw/data/json";
+import { debounce } from "@excalidraw/common";
+import { getNonDeletedElements } from "@excalidraw/element";
+
+import type { ExcalidrawImperativeAPI } from "@excalidraw/excalidraw/types";
+
+import { STORAGE_KEYS } from "./app_constants";
+
+// The localidraw server owns the drawing shown on this port: load it on start,
+// mirror every change back, and pick up edits made elsewhere (e.g. by the CLI).
+
+// This port may have shown a different drawing before, so never restore the
+// scene the browser cached for it; the server's copy is loaded instead.
+localStorage.removeItem(STORAGE_KEYS.LOCAL_STORAGE_ELEMENTS);
+
+// set so App.tsx skips Excalidraw's cross-tab sync from browser storage
+export const isLocalidraw = true;
+
+// served by the localidraw server on its main port
+export const GALLERY_URL = "/localidraw/gallery";
+
+let rev: string | null = null;
+let exists = false;
+let lastSavedVersion = -1;
+let isSaving = false;
+let saving: Promise<void> = Promise.resolve();
+let api: ExcalidrawImperativeAPI | null = null;
+
+const save = async () => {
+  if (!api) {
+    return;
+  }
+  const elements = api.getSceneElementsIncludingDeleted();
+  const appState = api.getAppState();
+  const files = api.getFiles();
+  const version = getSceneVersion(elements);
+  const visibleElements = getNonDeletedElements(elements);
+  // skip untouched blank canvases so they don't clutter the gallery
+  if (
+    rev === null ||
+    version === lastSavedVersion ||
+    (!visibleElements.length && !exists)
+  ) {
+    return;
+  }
+  isSaving = true;
+  try {
+    const svg = await exportToSvg({
+      elements: visibleElements,
+      appState: { ...appState, exportBackground: true },
+      files,
+      skipInliningFonts: true,
+    });
+    const response = await fetch("/localidraw/save", {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({
+        rev,
+        scene: serializeAsJSON(elements, appState, files, "local"),
+        // the export format drops the name; keep it for the gallery
+        name: appState.name,
+        svg: svg.outerHTML,
+      }),
+    });
+    if (response.ok) {
+      ({ rev } = await response.json());
+      exists = true;
+      lastSavedVersion = version;
+    } else if (response.status === 409) {
+      // someone else changed the drawing since we loaded it: reload theirs
+      window.location.reload();
+    }
+  } finally {
+    isSaving = false;
+  }
+};
+
+export const saveToLocalidraw = debounce(() => {
+  saving = save();
+}, 1000);
+
+const hasUnsavedChanges = (api: ExcalidrawImperativeAPI) =>
+  getSceneVersion(api.getSceneElementsIncludingDeleted()) !== lastSavedVersion;
+
+const loadScene = async (
+  api: ExcalidrawImperativeAPI,
+  isInitialLoad: boolean,
+) => {
+  const response = await fetch(
+    isInitialLoad ? "/localidraw/scene" : `/localidraw/scene?rev=${rev}`,
+  );
+  if (response.status !== 200) {
+    return;
+  }
+  const data = await response.json();
+  // the user started editing while we were fetching: keep their changes
+  if (!isInitialLoad && (isSaving || hasUnsavedChanges(api))) {
+    return;
+  }
+  const scene = data.scene ?? {};
+  // the CLI may write simplified element skeletons; expand them here
+  // (converted together so arrows can bind to shapes by id, then put back in
+  // their original order, which is also the drawing order)
+  const rawElements: any[] = scene.elements ?? [];
+  const converted = new Map(
+    convertToExcalidrawElements(
+      rawElements.filter((element) => element.version === undefined),
+      { regenerateIds: false },
+    ).map((element) => [element.id, element]),
+  );
+  const elements = restoreElements(
+    [
+      ...rawElements.map((element) => converted.get(element.id) ?? element),
+      // skeleton labels and bound text have no entry of their own in rawElements
+      ...[...converted.values()].filter(
+        (element) => !rawElements.some((raw) => raw.id === element.id),
+      ),
+    ],
+    null,
+    { repairBindings: true },
+  );
+  api.updateScene({
+    elements,
+    appState: {
+      name: scene.appState?.name ?? null,
+      viewBackgroundColor: scene.appState?.viewBackgroundColor ?? "#ffffff",
+    },
+    captureUpdate: CaptureUpdateAction.NEVER,
+  });
+  if (scene.files) {
+    api.addFiles(Object.values(scene.files));
+  }
+  rev = data.rev;
+  exists = !!data.scene;
+  lastSavedVersion = getSceneVersion(api.getSceneElementsIncludingDeleted());
+  if (isInitialLoad && elements.length) {
+    api.setViewport({ target: elements, fit: "scale-down" });
+  }
+  // drawings written by the CLI have no thumbnail yet: save once to render it
+  if (exists && !data.hasThumb) {
+    lastSavedVersion = -1;
+    saveToLocalidraw();
+  }
+};
+
+export const startLocalidraw = (excalidrawAPI: ExcalidrawImperativeAPI) => {
+  if (api) {
+    return;
+  }
+  api = excalidrawAPI;
+  loadScene(excalidrawAPI, true);
+  window.setInterval(() => {
+    if (rev !== null && !isSaving && !hasUnsavedChanges(excalidrawAPI)) {
+      loadScene(excalidrawAPI, false);
+    }
+  }, 2000);
+  window.addEventListener(
+    "keydown",
+    async (event) => {
+      if (
+        !(event.ctrlKey || event.metaKey) ||
+        event.shiftKey ||
+        event.key.toLowerCase() !== "s"
+      ) {
+        return;
+      }
+      event.preventDefault();
+      event.stopImmediatePropagation();
+      saveToLocalidraw.flush();
+      await saving;
+      const response = await fetch("/localidraw/sync", { method: "POST" });
+      const { synced } = await response.json();
+      excalidrawAPI.setToast({
+        message: synced
+          ? "Synced to Hugging Face"
+          : "Saved locally, will sync when online",
+        duration: 3000,
+      });
+    },
+    { capture: true },
+  );
+};
